# Auto Torque SQLite database (default for development / desktop)
# File is created under ./data/auto_torque.sqlite on first db push
DATABASE_URL="file:./data/auto_torque.sqlite"

# Authentication — use a long random string (at least 32 chars)
# PowerShell: -join ((1..48) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
BETTER_AUTH_SECRET="your-secret-here-at-least-32-random-characters"

# App URL (used by both the app and Better Auth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to true only when Cloudflare proxies every request AND the origin
# refuses traffic that did not come through it.
TRUST_CF_CONNECTING_IP=false
